<%@ page import="java.util.*,com.campus.model.*" %>
<% Event ev=(Event)request.getAttribute("event"); boolean edit=ev!=null; List<Coordinator> cs=(List<Coordinator>)request.getAttribute("coordinators"); %>
<!DOCTYPE html><html><head><title>Event Form</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1><%=edit?"Update":"Create"%> Event</h1><%@ include file="../common/messages.jspf" %><form method="post" class="card" data-validate><% if(edit){ %><input type="hidden" name="id" value="<%=ev.getId()%>"><% } %><div class="form-grid"><label>Title<input name="title" value="<%=edit?ev.getTitle():""%>" required></label><label>Category<input name="category" value="<%=edit?ev.getCategory():"Technical"%>" required></label><label>Venue<input name="venue" value="<%=edit?ev.getVenue():""%>" required></label><label>Date<input type="date" name="eventDate" value="<%=edit?ev.getEventDate():""%>" required></label><label>Start Time<input name="startTime" value="<%=edit?ev.getStartTime():"10:00 AM"%>" required></label><label>End Time<input name="endTime" value="<%=edit?ev.getEndTime():"12:00 PM"%>" required></label><label>Capacity<input type="number" name="capacity" min="1" value="<%=edit?ev.getCapacity():100%>" required></label><label>Coordinator<select name="coordinatorId"><% if(cs!=null) for(Coordinator c:cs){ %><option value="<%=c.getId()%>" <%=edit&&ev.getCoordinatorId()==c.getId()?"selected":""%>><%=c.getName()%></option><% } %></select></label></div><label>Description<textarea name="description" required><%=edit?ev.getDescription():""%></textarea></label><button class="button">Save Event</button></form></main></div></body></html>
