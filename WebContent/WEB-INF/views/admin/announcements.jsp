<%@ page import="java.util.*,com.campus.model.Announcement" %>
<!DOCTYPE html><html><head><title>Announcements</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Announcements</h1><form method="post" class="card"><div class="form-grid"><label>Title<input name="title" required></label><label>Audience<select name="audience"><option>ALL</option><option>STUDENT</option><option>COORDINATOR</option></select></label></div><label>Message<textarea name="message" required></textarea></label><button>Publish</button></form><div class="grid cards"><% List<Announcement> rows=(List<Announcement>)request.getAttribute("announcements"); if(rows!=null) for(Announcement a:rows){ %><article class="card"><h3><%=a.getTitle()%></h3><p><%=a.getMessage()%></p><small><%=a.getAudience()%> | <%=a.getCreatedAt()%></small></article><% } %></div></main></div></body></html>
