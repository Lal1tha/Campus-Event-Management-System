<%@ page import="java.util.*,com.campus.model.ReportRow" %>
<!DOCTYPE html><html><head><title>Reports</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Reports</h1><nav class="actions"><a class="button secondary" href="?type=events">Events</a><a class="button secondary" href="?type=attendance">Attendance</a><a class="button secondary" href="?type=registrations">Registrations</a><a class="button secondary" href="?type=students">Students</a><a class="button secondary" href="?type=coordinators">Coordinators</a></nav><div class="table-wrap"><table><% List<ReportRow> rows=(List<ReportRow>)request.getAttribute("rows"); if(rows!=null&&!rows.isEmpty()){ %><tr><% for(String h:rows.get(0).getValues().keySet()){ %><th><%=h%></th><% } %></tr><% for(ReportRow row:rows){ %><tr><% for(String v:row.getValues().values()){ %><td><%=v%></td><% } %></tr><% }} %></table></div></main></div></body></html>
