<%@ page import="java.util.*,com.campus.model.Coordinator" %>
<!DOCTYPE html><html><head><title>Coordinators</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><script defer src="<%=request.getContextPath()%>/assets/js/validation.js"></script></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Manage Coordinators</h1><%@ include file="../common/messages.jspf" %><form method="post" class="card form-grid" data-validate><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone" required></label><label>Department<input name="department" required></label><label>Password<input type="password" name="password" required></label><button>Add Coordinator</button></form><div class="table-wrap"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Department</th><th>Active</th></tr><% List<Coordinator> rows=(List<Coordinator>)request.getAttribute("coordinators"); if(rows!=null) for(Coordinator c:rows){ %><tr><td><%=c.getName()%></td><td><%=c.getEmail()%></td><td><%=c.getPhone()%></td><td><%=c.getDepartment()%></td><td><%=c.isActive()%></td></tr><% } %></table></div></main></div></body></html>
