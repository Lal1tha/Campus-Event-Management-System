<%@ page import="java.util.*,com.campus.model.Student" %>
<!DOCTYPE html><html><head><title>Students</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Manage Students</h1><form class="actions"><input name="q" placeholder="Search students"><button>Search</button></form><div class="table-wrap"><table><tr><th>Name</th><th>USN</th><th>Email</th><th>Phone</th><th>Department</th><th>Semester</th></tr><% List<Student> rows=(List<Student>)request.getAttribute("students"); if(rows!=null) for(Student s:rows){ %><tr><td><%=s.getName()%></td><td><%=s.getUsn()%></td><td><%=s.getEmail()%></td><td><%=s.getPhone()%></td><td><%=s.getDepartment()%></td><td><%=s.getSemester()%></td></tr><% } %></table></div></main></div></body></html>
