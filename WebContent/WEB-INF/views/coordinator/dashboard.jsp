<%@ page import="java.util.*,com.campus.model.Event" %>
<!DOCTYPE html><html><head><title>Coordinator Dashboard</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Assigned Events</h1><%@ include file="../common/messages.jspf" %><div class="grid cards"><% List<Event> events=(List<Event>)request.getAttribute("events"); if(events!=null) for(Event e:events){ %><article class="card"><h3><%=e.getTitle()%></h3><p><%=e.getEventDate()%> | <%=e.getVenue()%></p><p>Status: <%=e.getStatus()%></p><div class="actions"><a class="button secondary" href="participants?eventId=<%=e.getId()%>">Participants</a><a class="button secondary" href="attendance?eventId=<%=e.getId()%>">Attendance</a></div></article><% } %></div></main></div></body></html>
