<%@ page import="java.util.*,com.campus.model.Attendance" %>
<!DOCTYPE html><html><head><title>Attendance List</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Attendance List</h1><div class="table-wrap"><table><tr><th>Student</th><th>Event</th><th>Marked At</th></tr><% List<Attendance> rows=(List<Attendance>)request.getAttribute("attendance"); if(rows!=null) for(Attendance a:rows){ %><tr><td><%=a.getStudentName()%></td><td><%=a.getEventTitle()%></td><td><%=a.getMarkedAt()%></td></tr><% } %></table></div></main></div></body></html>
