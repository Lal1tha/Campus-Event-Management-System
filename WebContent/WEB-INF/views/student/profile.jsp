<%@ page import="com.campus.model.Student" %>
<% Student s=(Student)request.getAttribute("student"); %>
<!DOCTYPE html><html><head><title>Profile</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><script defer src="<%=request.getContextPath()%>/assets/js/validation.js"></script></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Profile</h1><%@ include file="../common/messages.jspf" %><form method="post" class="card form-grid" data-validate><label>Name<input name="name" value="<%=s==null?"":s.getName()%>" required></label><label>USN<input value="<%=s==null?"":s.getUsn()%>" disabled></label><label>Email<input value="<%=s==null?"":s.getEmail()%>" disabled></label><label>Phone<input name="phone" value="<%=s==null?"":s.getPhone()%>" required></label><label>Department<input name="department" value="<%=s==null?"":s.getDepartment()%>" required></label><label>Semester<input type="number" name="semester" value="<%=s==null?1:s.getSemester()%>" min="1" max="8" required></label><button>Save Profile</button></form></main></div></body></html>
