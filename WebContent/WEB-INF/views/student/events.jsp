<%@ page import="java.util.*,com.campus.model.Event" %>
<!DOCTYPE html><html><head><title>Events</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><%@ include file="../common/header.jspf" %><div class="layout"><%@ include file="../common/sidebar.jspf" %><main class="content"><h1>Search Events</h1><%@ include file="../common/messages.jspf" %><form class="actions"><input name="q" placeholder="Search by title or venue"><input name="category" placeholder="Category"><button>Search</button></form><div class="grid cards"><% List<Event> events=(List<Event>)request.getAttribute("events"); if(events!=null) for(Event e:events){ %><article class="card"><h3><%=e.getTitle()%></h3><p><%=e.getDescription()%></p><p><strong><%=e.getEventDate()%></strong> <%=e.getStartTime()%> - <%=e.getEndTime()%></p><p><%=e.getVenue()%> | Seats: <%=e.getCapacity()%></p><form method="post" action="events/register"><input type="hidden" name="eventId" value="<%=e.getId()%>"><button>Register</button></form></article><% } %></div></main></div></body></html>
