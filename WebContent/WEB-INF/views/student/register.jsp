<!DOCTYPE html><html><head><title>Student Registration</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"><script defer src="<%=request.getContextPath()%>/assets/js/validation.js"></script></head>
<body class="center"><form class="auth-card" method="post" data-validate><h1>Student Registration</h1><%@ include file="../common/messages.jspf" %>
<label>Name<input name="name" required></label><label>USN<input name="usn" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone" required></label><label>Department<input name="department" required></label><label>Semester<input type="number" min="1" max="8" name="semester" required></label><label>Password<input type="password" name="password" required></label><button class="button">Create Account</button><a href="<%=request.getContextPath()%>/login">Already registered?</a></form></body></html>
